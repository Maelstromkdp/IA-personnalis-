# Clé API Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modèles
MAELSTROM_MODEL_MAIN=claude-opus-4-8
MAELSTROM_MODEL_FAST=claude-haiku-4-5

# Effort par défaut (low | medium | high | xhigh | max)
MAELSTROM_EFFORT_DEFAULT=high

# Recherche web : "claude" (natif, par défaut) ou "tavily"
MAELSTROM_WEB_SEARCH=claude
# TAVILY_API_KEY=tvly-...   # requis seulement si MAELSTROM_WEB_SEARCH=tavily

# Garde-fou qualité : nombre max de réécritures par chapitre avant escalade
MAELSTROM_MAX_REVISIONS=2

# Dossier de sortie
MAELSTROM_OUTPUT_DIR=./output

# RAG (optionnel, désactivé par défaut)
MAELSTROM_RAG_ENABLED=false
