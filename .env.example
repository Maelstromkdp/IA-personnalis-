# Clé API Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modèles (laisser tel quel sauf besoin spécifique)
KDP_MODEL_MAIN=claude-opus-4-8
KDP_MODEL_FAST=claude-haiku-4-5

# Effort par défaut pour les tâches de raisonnement (low | medium | high | xhigh | max)
KDP_EFFORT_DEFAULT=high

# RAG (optionnel, désactivé par défaut)
KDP_RAG_ENABLED=false
KDP_RAG_DIR=./.rag_store
